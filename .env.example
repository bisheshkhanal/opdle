# Supabase Transaction Pooler URL (port 6543 — required for Vercel serverless)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# Required in development; auto-detected on Vercel in production
NEXTAUTH_URL=http://localhost:3000
